#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""Emergency report without importing Enigma2 or the graphical plugin."""
import datetime
import glob
import os
import sys
sys.path.insert(0, '/usr/lib/enigma2/python/Plugins/Extensions')
from E2Doctor import runtime
from E2Doctor import PLUGIN_VERSION


def main():
    stamp=datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    path=sys.argv[1] if len(sys.argv)>1 else '/tmp/E2Doctor_Report_'+stamp+'.txt'
    if os.path.lexists(path):
        raise RuntimeError('Output already exists; choose another filename')
    lines=['E2 DOCTOR '+PLUGIN_VERSION+' — EMERGENCY REPORT',stamp,'']
    for filename in ('/proc/stb/info/model','/etc/image-version','/etc/os-release','/proc/meminfo','/proc/loadavg','/etc/resolv.conf'):
        try:
            with open(filename,'rb') as source:
                lines.extend([filename,source.read(65536).decode('utf-8','replace'),''])
        except OSError:
            pass
    for command in (['uname','-a'],['df','-h','/'],['df','-i','/'],['uptime'],['ip','addr'],['ip','route'],['ps','-eo','pid,comm,rss']):
        code,out,error=runtime.run_command(command,5)
        lines.extend([' '.join(command),out if code==0 else 'Unavailable: '+error,''])
    logs=[]
    for root in ('/home/root/logs','/media/hdd','/tmp','/var/log'):
        for log in glob.glob(root+'/*crash*.log'):
            try:
                if os.path.isfile(log) and not os.path.islink(log):logs.append((os.path.getmtime(log),log))
            except OSError:pass
    if logs:
        log=max(logs)[1]
        with open(log,'rb') as source:
            source.seek(0,os.SEEK_END);source.seek(max(0,source.tell()-256*1024))
            content=source.read().decode('utf-8','replace')
        lines.extend(['LATEST CRASHLOG: '+log,'\n'.join(line for line in content.splitlines() if any(key in line for key in ('Traceback','File "','Error:','Exception:','FATAL','Segmentation fault')))[-16000:]])
    lines.append('Recognised credentials are masked. Review this report before sharing.')
    runtime.atomic_write(path,runtime.redact('\n'.join(lines)))
    print(path)

if __name__=='__main__':
    try:main()
    except Exception as error:
        sys.stderr.write(str(error)+'\n');sys.exit(1)
